# Jaan Platform — Environment Variables
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (production only)
DATABASE_URL=postgres://user:pass@localhost:5432/jaan_platform

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS (production only, comma-separated)
CORS_ALLOWED_ORIGINS=https://jaan.app

# Line Notify
LINE_NOTIFY_TOKEN=

# Sensibo IoT
SENSIBO_API_KEY=
